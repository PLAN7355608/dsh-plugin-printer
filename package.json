{
  "name": "dsh-plugin-printer",
  "version": "1.3.5",
  "private": true,
  "description": "打印机与扫描仪控制插件：枚举设备与能力、按页码/份数/双面打印文件与图片、管理打印队列、扫描成多页 PDF 或图片。",
  "type": "module",
  "main": "index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/",
    "ps/",
    "cordis.patch.yml",
    "locale/",
    "icon.svg",
    "README.md",
    "test/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "dsh-plugin",
    "printer",
    "scan",
    "wia",
    "deepseek-harness"
  ],
  "license": "MIT"
}
